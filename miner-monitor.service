[Unit]
Description=MINER read-only Bitcoin monitor and local AI summary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miner-monitor
Group=miner-monitor
WorkingDirectory=/opt/miner-monitor
EnvironmentFile=-/etc/miner-monitor.env
ExecStart=/usr/bin/python3 /opt/miner-monitor/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
